---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.svelte";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import { getSiteConfig } from "../utils/site-config";

export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "product";
  jsonLd?: unknown | unknown[];
}

const siteConfig = await getSiteConfig();
const defaultDesc = `Shop online at ${siteConfig.storeName}.`;

const {
  title,
  description = defaultDesc,
  canonicalPath = Astro.url.pathname,
  image,
  type = "website",
  jsonLd,
} = Astro.props as Props;
const canonical = new URL(canonicalPath, Astro.url.origin).toString();
const robots =
  siteConfig.seo?.profile.indexable === false
    ? "noindex, nofollow"
    : "index, follow";
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="en" data-storefront-preset={siteConfig.storefrontPreset}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.storeName} />
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {
      jsonLdItems.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
        />
      ))
    }
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <AnnouncementBar />
    <CartDrawer client:idle />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
