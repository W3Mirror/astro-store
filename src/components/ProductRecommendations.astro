---
import { config } from "../utils/config";
import {
  getProductRecommendations,
  getStoreRecommendations,
  toMoney,
} from "../utils/medusa";
import Money from "./Money.svelte";
import RecommendationAddButton from "./RecommendationAddButton.svelte";
import ResponsiveImage from "./ResponsiveImage.svelte";

export interface Props {
  productId: string;
  collectionId?: string | null;
}

const { productId, collectionId } = Astro.props as Props;
let ranked: Array<{
  product: {
    id: string;
    title: string;
    handle?: string | null;
    thumbnail?: string | null;
    variant_id?: string | null;
    amount?: number | null;
    currency_code?: string | null;
  };
  reasons: string[];
  score: number;
  promotion_code?: string;
}> = [];

if (config.recommendationsEnabled) {
  try {
    ranked = await getStoreRecommendations({
      anchorProductIds: [productId],
      excludeProductIds: [productId],
      limit: 4,
    });
  } catch (error) {
    console.warn(
      "Deterministic recommendations unavailable; using collection fallback",
      error,
    );
  }
}

if (ranked.length === 0) {
  const fallback = await getProductRecommendations({
    productId,
    collectionId,
  });
  ranked = fallback.flatMap((product) => {
    if (!product) return [];
    const price = toMoney(product.variants?.[0]?.calculated_price);
    return [
      {
        product: {
          id: product.id,
          title: product.title,
          handle: product.handle,
          thumbnail: product.thumbnail,
          variant_id: product.variants?.[0]?.id,
          amount: price?.amount,
          currency_code: price?.currency_code,
        },
        reasons: ["From the same collection"],
        score: 1,
      },
    ];
  });
}
---

{
  ranked.length > 0 && (
    <section
      class="bg-white py-16 sm:py-24"
      aria-labelledby="recommendation-heading"
    >
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-[var(--store-accent)] uppercase">
            Chosen with context
          </p>
          <h2
            id="recommendation-heading"
            class="mt-2 text-2xl font-bold tracking-tight text-gray-900"
          >
            Complete your selection
          </h2>
        </div>
        {config.recommendationsEnabled && (
          <span class="rounded-full border border-[var(--store-line)] px-3 py-1 font-mono text-[10px] tracking-wide text-[var(--store-muted)] uppercase">
            Explainable ranking
          </span>
        )}
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ranked.map((recommendation) => (
          <article class="overflow-hidden rounded-[var(--store-radius)] border border-[var(--store-line)] bg-[var(--store-surface)] p-3">
            <a
              href={`/products/${recommendation.product.handle}`}
              class="group block"
            >
              <div class="aspect-square overflow-hidden rounded-[calc(var(--store-radius)-4px)] bg-zinc-100">
                <ResponsiveImage
                  image={
                    recommendation.product.thumbnail
                      ? { url: recommendation.product.thumbnail }
                      : null
                  }
                  alt={recommendation.product.title}
                  classList="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                  sizes="(min-width: 1024px) 260px, (min-width: 640px) 45vw, 90vw"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-4 font-semibold group-hover:underline">
                {recommendation.product.title}
              </h3>
            </a>
            {recommendation.product.amount != null &&
              recommendation.product.currency_code && (
                <div class="mt-1 text-sm font-semibold">
                  <Money
                    price={{
                      amount: recommendation.product.amount,
                      currency_code: recommendation.product.currency_code,
                    }}
                  />
                </div>
              )}
            <p class="mt-3 min-h-10 text-xs leading-relaxed text-[var(--store-muted)]">
              {recommendation.reasons.slice(0, 2).join(" · ")}
            </p>
            {recommendation.product.variant_id && (
              <RecommendationAddButton
                client:load
                variantId={recommendation.product.variant_id}
                promotionCode={recommendation.promotion_code}
              />
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
