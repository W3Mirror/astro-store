---
import { config } from "../../utils/config";
import {
  customerRequest,
  getCustomerToken,
  type WishlistItem,
} from "../../utils/customer-account";

const { productId, returnTo } = Astro.props as {
  productId: string;
  returnTo: string;
};
const token = getCustomerToken(Astro.cookies);
let wished = false;
if (token && config.customerEngagementEnabled) {
  try {
    const data = await customerRequest<{ wishlist: WishlistItem[] }>(
      "/store/customers/me/wishlist",
      { token },
    );
    wished = data.wishlist.some((item) => item.product_id === productId);
  } catch {
    wished = false;
  }
}
---

{
  config.customerEngagementEnabled &&
    (token ? (
      <form action="/api/account/wishlist" method="post">
        <input type="hidden" name="product_id" value={productId} />
        <input type="hidden" name="intent" value={wished ? "remove" : "add"} />
        <input type="hidden" name="return_to" value={returnTo} />
        <button
          class="mt-3 w-full rounded-[var(--store-radius)] border border-[var(--store-line)] px-6 py-3 font-semibold transition hover:border-[var(--store-accent)]"
          type="submit"
        >
          {wished ? "Remove from wishlist" : "Save to wishlist"}
        </button>
      </form>
    ) : (
      <a
        class="mt-3 block text-center text-sm font-semibold underline"
        href={`/account/login?return_to=${encodeURIComponent(returnTo)}`}
      >
        Sign in to save this item
      </a>
    ))
}
