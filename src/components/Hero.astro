---
import ResponsiveImage from "./ResponsiveImage.svelte";

export interface Props {
  heading: string;
  subheading?: string;
  imageUrl?: string | null;
  imageAlt?: string | null;
}

const { heading, subheading, imageUrl, imageAlt } = Astro.props as Props;
---

{
  heading && (
    <section class="store-hero border-b">
      <div class="store-hero__wash" aria-hidden="true" />
      <div class="store-hero__inner container py-16 sm:py-24">
        {imageUrl && (
          <div class="store-hero__image mb-8 overflow-hidden rounded-lg">
            <ResponsiveImage
              image={{ url: imageUrl }}
              alt={imageAlt || heading}
              loading="eager"
              fetchpriority="high"
              sizes="100vw"
            />
          </div>
        )}
        <p class="store-hero__eyebrow">The new collection</p>
        <div class="store-hero__copy">
          <h1 class="store-hero__heading text-4xl font-semibold tracking-tight sm:text-6xl">
            {heading}
          </h1>
          {subheading && (
            <p class="store-hero__subheading mt-5 max-w-2xl text-base sm:text-lg">
              {subheading}
            </p>
          )}
          <a class="store-hero__action" href="#featured-products">
            Shop the collection
          </a>
        </div>
      </div>
    </section>
  )
}
