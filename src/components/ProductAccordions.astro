---
const accordions = [
  {
    title: "Shipping and taxes",
    content: "Shipping and taxes are calculated at checkout.",
  },
];
---

<div class="grid">
  {
    accordions.map((accordion, index) => (
      <details
        class:list={[
          "group",
          "border-t",
          { "border-b": index === accordions.length - 1 },
        ]}
      >
        <summary class="flex cursor-pointer items-center justify-between px-1 py-3 font-bold text-zinc-700">
          <span>{accordion.title}</span>
          <span class="transition group-open:rotate-180" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-4 w-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"
              />
            </svg>
          </span>
        </summary>
        <div class="p-4 text-sm text-zinc-600">{accordion.content}</div>
      </details>
    ))
  }
</div>
