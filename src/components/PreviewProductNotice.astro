---
// Preview links only (see `utils/preview.js`): says what the shopper-to-be
// is looking at on a product page — a DRAFT (not on the live store, can't
// be bought), or a product with staged changes (shown as they'll look once
// published; the bag and checkout still use the current live prices,
// because staged prices are never charged) — and whether it is UNLISTED
// (only reachable at its product link; see `utils/visibility.js`).
export interface Props {
  state: "draft" | "pending" | null;
  unlisted?: boolean;
}
const { state, unlisted = false } = Astro.props as Props;
---

<div class="preview-product-notice mt-4 rounded-md px-4 py-3 text-sm" role="note" data-preview-state={state ?? "live"} data-preview-unlisted={unlisted ? "true" : undefined}>
  {
    unlisted && (
      <p>
        <span class="preview-badge">Unlisted</span> Only reachable at this
        product link: hidden from product listings, search, collections and
        the sitemap, and not indexed by search engines. It can still be
        bought here.
      </p>
    )
  }
  {
    state === null ? null : state === "draft" ? (
      <p>
        <span class="preview-badge">Draft</span> Not on the live store yet.
        Adding to the bag is disabled in this preview.
      </p>
    ) : (
      <p>
        <span class="preview-badge">Pending changes</span> Shown as it will
        look once published. The bag and checkout still use the current live
        price until then.
      </p>
    )
  }
</div>

<style>
  .preview-product-notice {
    background-color: #fef3c7;
    color: #78350f;
  }
  .preview-badge {
    display: inline-block;
    margin-right: 0.375rem;
    border-radius: 9999px;
    background-color: #78350f;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fef3c7;
  }
</style>
