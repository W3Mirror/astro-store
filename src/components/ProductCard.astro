---
import type { z } from "zod";
import type { ProductResult } from "../utils/schemas";
import { toMoney } from "../utils/medusa";
import { getDefaultVariant } from "../utils/variant-selection";
import { getProductBadges } from "../utils/product-badges";
import { getPreview } from "../utils/preview-context";
import { previewStateOf } from "../utils/preview.js";

import ResponsiveImage from "./ResponsiveImage.svelte";
import Money from "./Money.svelte";

export interface Props {
  product: z.infer<typeof ProductResult>;
  priority?: boolean;
}
const { product, priority = false } = Astro.props as Props;
const featuredImage = product?.thumbnail
  ? { url: product.thumbnail }
  : (product?.images?.[0] ?? null);
// Item 6: desktop/hover-capable-only second-image swap — the product's next
// distinct image, purely additive (absolutely positioned over the first, so
// it never shifts layout; see `.product-card__image--secondary`).
const secondaryImage =
  product?.images?.find((image) => image?.url && image.url !== featuredImage?.url) ??
  null;
// The same "first in-stock, else first variant" rule the PDP uses
// (`getDefaultVariant`) — so the card's price/sale badge always describe a
// variant a shopper could actually buy when one exists, not just whichever
// happens to be declared first.
const defaultVariant = product ? getDefaultVariant(product) : undefined;
const price = toMoney(defaultVariant?.calculated_price);
const badges = product ? getProductBadges(product, defaultVariant) : null;
// Preview links only (always `null` on a normal request).
const previewState = product
  ? previewStateOf(await getPreview(Astro), product.id)
  : null;
---

<a
  href={`/products/${product?.handle}`}
  class="product-card group overflow-hidden rounded-lg"
>
  <div class="relative product-card__media">
    <ResponsiveImage
      classList="product-card__image product-card__image--primary"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      image={featuredImage}
      alt={product?.title}
      sizes={`
      (min-width: 1540px) 348px,
      (min-width: 1280px) 284px,
      (min-width: 1040px) 309px,
      (min-width: 780px) 348px,
      (min-width: 640px) 284px,
      calc(100vw - 48px)
    `}
    />
    {
      secondaryImage && (
        <ResponsiveImage
          classList="product-card__image product-card__image--secondary"
          loading="lazy"
          image={secondaryImage}
          alt=""
        />
      )
    }
    {
      previewState && (
        <div class="product-card__badges" data-preview-state={previewState}>
          <span class="product-card__badge product-card__badge--preview">
            {previewState === "draft" ? "Draft" : "Pending changes"}
          </span>
        </div>
      )
    }
    {
      !previewState && badges && (badges.soldOut || badges.sale || badges.isNew) && (
        <div class="product-card__badges">
          {badges.soldOut ? (
            <span class="product-card__badge product-card__badge--sold-out">
              Sold out
            </span>
          ) : (
            <>
              {badges.sale && (
                <span class="product-card__badge product-card__badge--sale">Sale</span>
              )}
              {badges.isNew && (
                <span class="product-card__badge product-card__badge--new">New</span>
              )}
            </>
          )}
        </div>
      )
    }
    <div
      class="absolute inset-0 z-10 grid items-end justify-items-center opacity-0 transition-all group-hover:bg-black/10 group-hover:opacity-100"
    >
      <button class="button w-full gap-3 rounded-none">
        <span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="h-5 w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"
            ></path>
          </svg>
        </span>
        Shop now
      </button>
    </div>
  </div>
  <div class="product-card__copy flex justify-between px-5 py-6">
    <h3 class="group-hover:underline">{product?.title}</h3>
    <p class="product-card__price font-bold">
      <Money price={price} />
      {
        badges?.comparePrice && (
          <span class="product-card__compare-price">
            <Money price={badges.comparePrice} />
          </span>
        )
      }
    </p>
  </div>
</a>
