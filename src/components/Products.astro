---
import { z } from "zod";
import { ProductResult } from "../utils/schemas";
import ProductCard from "./ProductCard.astro";

const ProductsResult = z.array(ProductResult);
export interface Props {
  products: z.infer<typeof ProductsResult>;
  eyebrow?: string;
  heading?: string;
  // Skips this component's own `.container` padding — for a caller that
  // already renders inside its own `.container` (the `/products` and
  // `/collections/<handle>` filter sidebar layouts), so the two don't
  // double up `.container`'s padding-inline. The homepage (this
  // component's other caller) renders it standalone and needs the default
  // `false` behavior.
  bare?: boolean;
}
const {
  products,
  eyebrow = "Selected for you",
  heading = "Featured collection",
  bare = false,
} = Astro.props as Props;
---

<section id="featured-products" class="products-section">
  <div class:list={[bare ? "" : "container", "py-16 sm:py-20"]}>
    <div class="products-section__heading">
      <p>{eyebrow}</p>
      <h2>{heading}</h2>
    </div>

    <div class="products-grid grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        products.map((product, index) => (
          <ProductCard product={product} priority={index === 0} />
        ))
      }
    </div>
  </div>
</section>
