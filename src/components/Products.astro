---
import { z } from "zod";
import { ProductResult } from "../utils/schemas";
import ProductCard from "./ProductCard.astro";

const ProductsResult = z.array(ProductResult);
export interface Props {
  products: z.infer<typeof ProductsResult>;
}
const { products } = Astro.props as Props;
---

<section id="featured-products" class="products-section">
  <div class="container py-16 sm:py-20">
    <div class="products-section__heading">
      <p>Selected for you</p>
      <h2>Featured collection</h2>
    </div>

    <div class="products-grid grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        products.map((product, index) => (
          <ProductCard product={product} priority={index === 0} />
        ))
      }
    </div>
  </div>
</section>
