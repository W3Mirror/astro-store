---
import { getProducts } from "./../utils/medusa";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import { setCache } from "../utils/cache";
import { getSiteConfig } from "../utils/site-config";
import { getHomepageSeo } from "../utils/seo";

// The one neutral default hero copy, used whenever the site-config overlay
// doesn't supply its own `heroHeading`/`heroSubheading`.
const DEFAULT_HERO_HEADING = "Considered goods for everyday life.";
const DEFAULT_HERO_SUBHEADING =
  "A focused collection chosen for quality, utility, and lasting appeal.";

const siteConfig = await getSiteConfig();
const seo = getHomepageSeo(siteConfig);
const products = await getProducts({});

setCache.long(Astro, ["home"]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonicalPath="/"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: siteConfig.seo?.profile.organizationName || siteConfig.storeName,
      description:
        siteConfig.seo?.profile.organizationDescription || seo.description,
      url: new URL("/", Astro.url.origin).toString(),
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: siteConfig.storeName,
      url: new URL("/", Astro.url.origin).toString(),
      description: seo.description,
    },
  ]}
>
  <Hero
    heading={siteConfig.heroHeading || DEFAULT_HERO_HEADING}
    subheading={siteConfig.heroSubheading || DEFAULT_HERO_SUBHEADING}
  />
  <Products products={products} />
</BaseLayout>
