---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountNav from "../../components/account/AccountNav.astro";
import { config } from "../../utils/config";
import {
  customerRequest,
  getCustomerToken,
  type WishlistItem,
} from "../../utils/customer-account";
const token = getCustomerToken(Astro.cookies);
if (!token) return Astro.redirect("/account/login");
let wishlist: WishlistItem[] = [];
if (config.customerEngagementEnabled)
  wishlist = (
    await customerRequest<{ wishlist: WishlistItem[] }>(
      "/store/customers/me/wishlist",
      { token },
    )
  ).wishlist;
---

<BaseLayout title="Your wishlist">
  <section class="container py-12 lg:py-20">
    <p
      class="text-xs font-bold tracking-[0.22em] text-[var(--store-muted)] uppercase"
    >
      Saved for later
    </p><h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
      Your wishlist.
    </h1>
    <div class="mt-10"><AccountNav active="wishlist" /></div>
    {
      !config.customerEngagementEnabled ? (
        <p class="account-card text-[var(--store-muted)]">
          Wishlists will be available after this store completes its
          customer-data rollout.
        </p>
      ) : wishlist.length === 0 ? (
        <div class="account-card text-center">
          <>
            <h2 class="text-2xl font-bold">Nothing saved yet.</h2>
            <p class="mt-2 text-[var(--store-muted)]">
              Keep the pieces you love close at hand.
            </p>
            <a class="button mx-auto mt-6 w-fit" href="/">
              Browse the store
            </a>
          </>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {wishlist.map((item) => (
            <article class="overflow-hidden rounded-[var(--store-radius)] border border-[var(--store-line)] bg-[var(--store-surface)]">
              <a href={`/products/${item.product.handle}`}>
                {item.product.thumbnail ? (
                  <img
                    class="aspect-square w-full object-cover"
                    src={item.product.thumbnail}
                    alt=""
                    loading="lazy"
                  />
                ) : (
                  <div class="aspect-square bg-[var(--store-line)]" />
                )}
                <h2 class="p-5 text-lg font-bold">{item.product.title}</h2>
              </a>
              <form
                class="px-5 pb-5"
                action="/api/account/wishlist"
                method="post"
              >
                <input
                  type="hidden"
                  name="product_id"
                  value={item.product_id}
                />
                <input type="hidden" name="intent" value="remove" />
                <input
                  type="hidden"
                  name="return_to"
                  value="/account/wishlist"
                />
                <button class="text-sm font-semibold underline" type="submit">
                  Remove
                </button>
              </form>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
