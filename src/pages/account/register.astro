---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCustomerToken } from "../../utils/customer-account";
if (getCustomerToken(Astro.cookies)) return Astro.redirect("/account");
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Create account">
  <section class="container grid min-h-[70vh] place-items-center py-16">
    <div
      class="w-full max-w-lg rounded-[var(--store-radius)] border border-[var(--store-line)] bg-[var(--store-surface)] p-8 shadow-[var(--store-shadow)]"
    >
      <p
        class="text-xs font-bold tracking-[0.22em] text-[var(--store-muted)] uppercase"
      >
        A place for your favourites
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">Make it yours.</h1>
      {
        error && (
          <p
            role="alert"
            class="mt-5 rounded-lg bg-red-50 p-3 text-sm text-red-800"
          >
            {error}
          </p>
        )
      }
      <form
        class="mt-8 grid gap-5 sm:grid-cols-2"
        action="/api/account/register"
        method="post"
      >
        <label class="block text-sm font-semibold"
          >First name<input
            class="account-input"
            name="first_name"
            autocomplete="given-name"
            required
          /></label
        >
        <label class="block text-sm font-semibold"
          >Last name<input
            class="account-input"
            name="last_name"
            autocomplete="family-name"
            required
          /></label
        >
        <label class="block text-sm font-semibold sm:col-span-2"
          >Email<input
            class="account-input"
            type="email"
            name="email"
            autocomplete="email"
            required
          /></label
        >
        <label class="block text-sm font-semibold sm:col-span-2"
          >Password<input
            class="account-input"
            type="password"
            name="password"
            minlength="8"
            autocomplete="new-password"
            required
          /></label
        >
        <button class="button sm:col-span-2" type="submit"
          >Create account</button
        >
      </form>
      <p class="mt-6 text-center text-sm text-[var(--store-muted)]">
        Already have an account? <a
          class="font-semibold text-[var(--store-ink)] underline"
          href="/account/login">Sign in</a>
      </p>
    </div>
  </section>
</BaseLayout>
