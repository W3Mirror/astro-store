---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCustomerToken } from "../../utils/customer-account";
if (getCustomerToken(Astro.cookies)) return Astro.redirect("/account");
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Sign in">
  <section class="container grid min-h-[70vh] place-items-center py-16">
    <div
      class="w-full max-w-md rounded-[var(--store-radius)] border border-[var(--store-line)] bg-[var(--store-surface)] p-8 shadow-[var(--store-shadow)]"
    >
      <p
        class="text-xs font-bold tracking-[0.22em] text-[var(--store-muted)] uppercase"
      >
        Customer account
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">Welcome back.</h1>
      <p class="mt-3 text-sm text-[var(--store-muted)]">
        See your orders, addresses, and saved pieces in one place.
      </p>
      {
        error && (
          <p
            role="alert"
            class="mt-5 rounded-lg bg-red-50 p-3 text-sm text-red-800"
          >
            {error}
          </p>
        )
      }
      <form class="mt-8 space-y-5" action="/api/account/login" method="post">
        <label class="block text-sm font-semibold"
          >Email<input
            class="account-input"
            type="email"
            name="email"
            autocomplete="email"
            required
          /></label
        >
        <label class="block text-sm font-semibold"
          >Password<input
            class="account-input"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          /></label
        >
        <button class="button w-full" type="submit">Sign in</button>
      </form>
      <p class="mt-6 text-center text-sm text-[var(--store-muted)]">
        New here? <a
          class="font-semibold text-[var(--store-ink)] underline"
          href="/account/register">Create an account</a>
      </p>
    </div>
  </section>
</BaseLayout>
