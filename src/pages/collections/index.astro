---
import { getCollections } from "../../utils/medusa";
import BaseLayout from "../../layouts/BaseLayout.astro";

const collectionsPage = await getCollections({ limit: 100 });
const collections = collectionsPage.product_categories.filter(
  (collection) => collection !== null,
);
---

<BaseLayout
  title="Collections"
  description="Browse this store's collections."
  canonicalPath="/collections"
>
  <section class="container pt-10 pb-4">
    <p class="text-sm font-semibold tracking-wide text-emerald-900 uppercase">
      Browse
    </p>
    <h1 class="mt-2 text-3xl font-bold text-zinc-900 sm:text-4xl">
      Collections
    </h1>
  </section>

  <section class="container pb-16">
    {
      collections.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {collections.map((collection) => (
            <a
              href={`/collections/${collection.handle}`}
              class="rounded-lg border border-zinc-200 p-6 transition hover:border-emerald-900"
            >
              <h2 class="text-lg font-semibold text-zinc-900">
                {collection.name}
              </h2>
              {collection.description ? (
                <p class="mt-2 text-sm text-zinc-600">
                  {collection.description}
                </p>
              ) : null}
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-zinc-600">No collections yet.</p>
      )
    }
  </section>
</BaseLayout>
