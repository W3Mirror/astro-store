---
import { getCollectionByHandle, getProductPage } from "../../utils/medusa";
import { getProductPagination } from "../../utils/product-pagination";
import { parseProductQuery } from "../../utils/product-query";
import {
  applyProductFacetFilters,
  buildListingHref,
  deriveAvailabilityCounts,
  deriveOptionFacets,
  derivePriceBounds,
  FILTER_FETCH_CAP,
  isClientSideSort,
  parseProductFacetFilters,
  sortProducts,
} from "../../utils/product-filters";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotFoundLayout from "../../layouts/NotFoundLayout.astro";
import Products from "../../components/Products.astro";
import ProductFilters from "../../components/ProductFilters.astro";
import ProductPaginationNav from "../../components/ProductPaginationNav.astro";
import ResponsiveImage from "../../components/ResponsiveImage.svelte";

const { handle } = Astro.params;
const lookup = await getCollectionByHandle({ handle: handle || "" });

// A request for the raw/internal backend handle (an old bookmarked or
// indexed URL — see `getCollectionByHandle`'s doc comment) is permanently
// redirected to the clean, merchant-facing handle rather than rendered or
// 404ed, carrying over any query string (sort/pagination) unchanged.
if (lookup.kind === "redirect") {
  const target = new URL(Astro.url);
  target.pathname = `/collections/${lookup.canonicalHandle}`;
  return Astro.redirect(`${target.pathname}${target.search}`, 301);
}

const collection = lookup.kind === "found" ? lookup.category : null;

if (!collection) {
  Astro.response.status = 404;
}

// The route's own `handle` is the only source of collection scoping — a
// `?collections=` facet selection on this URL is ignored (this page is
// already scoped to one collection via its path) so a shopper or a crawled
// link can never widen/redirect this page to a different collection.
const { limit, offset, order } = parseProductQuery(Astro.url.searchParams);
const facetFilters = collection
  ? { ...parseProductFacetFilters(Astro.url.searchParams), collectionIds: [] }
  : null;

const pool =
  collection && facetFilters
    ? await getProductPage({
        limit: FILTER_FETCH_CAP,
        offset: 0,
        categoryId: collection.id,
        order: isClientSideSort(order) ? "-created_at" : order,
      })
    : null;

const filtered =
  pool && facetFilters ? applyProductFacetFilters(pool.products, facetFilters) : [];
const sorted = sortProducts(filtered, order);
const pageProducts = sorted.slice(offset, offset + limit);

const pagination =
  pool && facetFilters
    ? getProductPagination({
        offset,
        limit,
        count: sorted.length,
        productCount: pageProducts.length,
        countIsEstimated: false,
      })
    : null;

const pageHref = (nextOffset: number) =>
  buildListingHref(`/collections/${collection?.handle ?? handle}`, {
    order,
    limit,
    offset: nextOffset,
    facets: facetFilters ?? { inStockOnly: false, collectionIds: [], optionFilters: {} },
  });
---

{
  !collection || !pool || !pagination || !facetFilters ? (
    <NotFoundLayout
      title="Collection not found"
      message="Collection not found"
    />
  ) : (
    <BaseLayout
      title={collection.name}
      description={
        collection.description || `Shop the ${collection.name} collection.`
      }
      canonicalPath={`/collections/${collection.handle}`}
    >
      <section class="container pt-10 pb-4">
        {collection.bannerImageUrl && (
          <div class="mb-8 overflow-hidden rounded-lg">
            <ResponsiveImage
              image={{ url: collection.bannerImageUrl }}
              alt={collection.bannerImageAlt || collection.name}
              loading="eager"
              fetchpriority="high"
              sizes="100vw"
            />
          </div>
        )}
        <p class="text-sm font-semibold tracking-wide text-emerald-900 uppercase">
          Collection
        </p>
        <h1 class="mt-2 text-3xl font-bold text-zinc-900 sm:text-4xl">
          {collection.name}
        </h1>
        {collection.description ? (
          <p class="mt-4 max-w-2xl text-zinc-600">{collection.description}</p>
        ) : null}
      </section>

      <section class="container pb-4 lg:flex lg:items-start lg:gap-10">
        <ProductFilters
          basePath={`/collections/${collection.handle}`}
          limit={limit}
          order={order}
          filters={facetFilters}
          availability={deriveAvailabilityCounts(pool.products)}
          price={derivePriceBounds(pool.products)}
          options={deriveOptionFacets(pool.products)}
          resultLabel={pagination.label}
        />

        <div class="min-w-0 flex-1">
          {pageProducts.length > 0 ? (
            <Products
              products={pageProducts}
              eyebrow="Collection"
              heading={collection.name}
            />
          ) : (
            <p class="py-16 text-center text-zinc-600">
              No products in this collection match these filters.
            </p>
          )}
        </div>
      </section>

      <ProductPaginationNav
        pagination={pagination}
        pageHref={pageHref}
        previousOffset={Math.max(0, offset - limit)}
        nextOffset={offset + limit}
      />
    </BaseLayout>
  )
}
