---
import { getProductByHandle, toMoney } from "./../../utils/medusa";
import { setCache } from "../../utils/cache";
import {
  getVariantAvailability,
  resolveInitialVariant,
} from "../../utils/variant-selection";

import BaseLayout from "../../layouts/BaseLayout.astro";
import NotFoundLayout from "../../layouts/NotFoundLayout.astro";
import ProductVariantPicker from "../../components/ProductVariantPicker.svelte";
import ProductImageGallery from "../../components/ProductImageGallery.astro";
import ProductBreadcrumb from "../../components/ProductBreadcrumb.astro";
import ProductInformations from "../../components/ProductInformations.astro";
import ProductRecommendations from "../../components/ProductRecommendations.astro";
import ProductReviews from "../../components/ProductReviews.astro";
import ProductAccordions from "../../components/ProductAccordions.astro";
import { getSiteConfig } from "../../utils/site-config";
import { getProductSeo } from "../../utils/seo";
import WishlistControl from "../../components/account/WishlistControl.astro";
import RecommendationSignal from "../../components/RecommendationSignal.svelte";
import { config } from "../../utils/config";
import { getPreview } from "../../utils/preview-context";
import { previewStateOf } from "../../utils/preview.js";
import PreviewProductNotice from "../../components/PreviewProductNotice.astro";

const { handle } = Astro.params;
const preview = await getPreview(Astro);
const product = await getProductByHandle({ handle: handle || "" }, preview);
// Preview-link requests only (`null` otherwise): a DRAFT can't be bought,
// and a product with staged changes still checks out at its live price.
const previewState = product ? previewStateOf(preview, product.id) : null;
const siteConfig = await getSiteConfig();

if (!product) {
  Astro.response.status = 404;
}

// The variant/option picker (`ProductVariantPicker.svelte`) owns letting a
// shopper choose among a multi-variant product's options (Size/Colour/Type,
// etc.) — see `utils/variant-selection.ts`. Everything below only needs the
// SSR-selected variant (URL `?variant=<id>` if it names a real variant of
// this product, else the first available one) so the initial HTML, JSON-LD,
// and social/meta tags reflect the same variant the picker starts on.
const requestedVariantId = Astro.url.searchParams.get("variant");
const initialVariant = product
  ? resolveInitialVariant(product, requestedVariantId)
  : undefined;
const price = toMoney(initialVariant?.calculated_price);
const seo = product ? getProductSeo(product, siteConfig.storeName) : null;
const { availableForSale: variantAvailableForSale } =
  getVariantAvailability(initialVariant);
setCache.short(Astro, product ? ["product", `product:${product.handle}`] : []);
---

{
  !product ? (
    <NotFoundLayout title="Product not found" message="Product not found" />
  ) : (
    <BaseLayout
      title={seo?.title || product.title}
      description={seo?.description}
      canonicalPath={`/products/${product.handle}`}
      image={product.thumbnail || product.images[0]?.url}
      type="product"
      jsonLd={{
        "@context": "https://schema.org",
        "@type": "Product",
        name: product.title,
        description: product.description || seo?.description,
        image: product.images.map((image) => image?.url).filter(Boolean),
        sku: initialVariant?.sku || undefined,
        url: new URL(
          `/products/${product.handle}`,
          Astro.url.origin,
        ).toString(),
        offers: price
          ? {
              "@type": "Offer",
              price: price.amount,
              priceCurrency: price.currency_code.toUpperCase(),
              availability: variantAvailableForSale
                ? "https://schema.org/InStock"
                : "https://schema.org/OutOfStock",
              url: new URL(
                `/products/${product.handle}`,
                Astro.url.origin,
              ).toString(),
            }
          : undefined,
      }}
    >
      <div class="container pt-6">
        <ProductBreadcrumb title={product.title} />
      </div>

      <section class="container">
        <div class="pt-6 pb-16 lg:grid lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7">
            <ProductImageGallery
              images={product.images}
              title={product.title}
            />
          </div>

          <div class="mt-8 lg:col-span-5 lg:mt-0">
            <ProductInformations title={product.title} />
            {previewState && <PreviewProductNotice state={previewState} />}

            <div>
              <ProductVariantPicker
                client:load
                product={product}
                initialVariantId={initialVariant?.id}
                sizeChartImageUrl={siteConfig.sizeChartImageUrl}
                customFitNote={siteConfig.customFitNote}
                productImageUrl={product.thumbnail || product.images[0]?.url || null}
                productTitle={product.title}
                purchaseBlocked={previewState === "draft"}
              />
              <WishlistControl
                productId={product.id}
                returnTo={`/products/${product.handle}`}
              />
            </div>

            <div class="mt-8">
              <ProductAccordions
                description={product.description}
                fabricCare={
                  typeof product.metadata?.fabric_care === "string"
                    ? product.metadata.fabric_care
                    : null
                }
                shippingText={siteConfig.shippingText}
                returnsText={siteConfig.returnsText}
                whatsappNumber={siteConfig.whatsappNumber}
              />
            </div>
          </div>
        </div>
      </section>

      {config.recommendationsEnabled && (
        <RecommendationSignal client:load productId={product.id} />
      )}

      <ProductReviews />

      <section class="container">
        <ProductRecommendations
          productId={product.id}
          categoryId={product.categories?.[0]?.id}
          collectionId={product.collection_id}
        />
      </section>
    </BaseLayout>
  )
}
