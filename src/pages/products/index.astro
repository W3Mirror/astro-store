---
import { getProductPage, getCollections, COLLECTIONS_MAX_LIMIT } from "../../utils/medusa";
import { getProductPagination } from "../../utils/product-pagination";
import { parseProductQuery } from "../../utils/product-query";
import {
  applyProductFacetFilters,
  buildListingHref,
  deriveAvailabilityCounts,
  deriveOptionFacets,
  derivePriceBounds,
  FILTER_FETCH_CAP,
  isClientSideSort,
  parseProductFacetFilters,
  resolveCollectionFacetIds,
  sortProducts,
} from "../../utils/product-filters";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Products from "../../components/Products.astro";
import ProductFilters from "../../components/ProductFilters.astro";
import ProductPaginationNav from "../../components/ProductPaginationNav.astro";

const params = Astro.url.searchParams;
const { limit, offset, query, order, collectionId, categoryId } =
  parseProductQuery(params);
const facetFilters = parseProductFacetFilters(params);
// Opaque legacy deep-link params (e.g. an old integration linking straight
// at a `product_collection`/`product_category` id) — round-tripped through
// every generated href, never exposed as a shopper-facing filter control
// (see `buildListingHref`'s doc comment). Independent of, and additive
// with, the shopper-facing "Collection" facet below.
const stickyParams = { collection_id: collectionId, category_id: categoryId };

// Fetched first: the "Collection" facet's `?collections=` URL param carries
// clean, shareable HANDLES (or, for backward compatibility, a legacy raw
// handle or raw backend id — see `resolveCollectionFacetIds`'s doc comment),
// but the Store API's `category_id` filter needs the real id. This is the
// same request `getCollectionByHandle` already makes elsewhere, so
// resolving up front costs nothing beyond the one call this facet sidebar
// needed anyway.
const collections = await getCollections({ limit: COLLECTIONS_MAX_LIMIT })
  .then((page) =>
    page.product_categories
      .filter((c) => c !== null)
      .map((c) => ({ id: c.id, name: c.name, handle: c.handle, rawHandle: c.rawHandle })),
  )
  .catch((error) => {
    console.error(
      "[products] Failed to load the collection list for the filter facet; showing none.",
      error,
    );
    return [];
  });

// The whole listing (grid + facet sidebar) is served from one bounded pool
// of candidate products — see `product-filters.ts`'s module doc for why
// (Availability/Price/option-value facets can't be expressed as Store API
// query params) and its documented limitation (a catalog bigger than
// `FILTER_FETCH_CAP` only surfaces facets/results from its first page,
// server-sorted). The "Collection" facet IS a real Store API param, so it's
// applied here, server-side, before the pool is even fetched, alongside any
// legacy `?category_id=` deep link.
const resolvedCollectionIds = resolveCollectionFacetIds(
  facetFilters.collectionIds,
  collections,
);
const scopedCategoryIds = [
  ...(categoryId ? [categoryId] : []),
  ...resolvedCollectionIds,
];
const pool = await getProductPage({
  limit: FILTER_FETCH_CAP,
  offset: 0,
  q: query,
  collectionId,
  categoryId: scopedCategoryIds.length > 0 ? scopedCategoryIds : undefined,
  // A price sort can't be requested from the Store API — fetch the pool in
  // the default order and sort client-side (`sortProducts`) instead.
  order: isClientSideSort(order) ? "-created_at" : order,
});

const filtered = applyProductFacetFilters(pool.products, facetFilters);
const sorted = sortProducts(filtered, order);
const pageProducts = sorted.slice(offset, offset + limit);

const pageTitle = query ? `Search results for “${query}”` : "All products";
const pagination = getProductPagination({
  offset,
  limit,
  count: sorted.length,
  productCount: pageProducts.length,
  countIsEstimated: false,
});

const pageHref = (nextOffset: number) =>
  buildListingHref("/products", {
    q: query,
    order,
    limit,
    offset: nextOffset,
    facets: facetFilters,
    stickyParams,
  });
---

<BaseLayout
  title={pageTitle}
  description="Browse products available from this store."
  canonicalPath="/products"
>
  <section class="container pt-10 pb-4">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-emerald-900 uppercase">
        Catalog
      </p>
      <h1 class="mt-2 text-3xl font-bold text-zinc-900 sm:text-4xl">
        {pageTitle}
      </h1>
    </div>

    <form method="get" class="mt-8 flex flex-wrap items-end gap-3">
      <div class="flex-1">
        <label class="text-sm font-medium text-zinc-700" for="product-search">
          Search products
        </label>
        <input
          id="product-search"
          type="search"
          name="q"
          value={query || ""}
          placeholder="Search by product name"
          class="mt-2 w-full rounded-md border border-zinc-300 bg-white px-3 py-2"
        />
      </div>
      <input type="hidden" name="limit" value={limit} />
      {collectionId && <input type="hidden" name="collection_id" value={collectionId} />}
      {categoryId && <input type="hidden" name="category_id" value={categoryId} />}
      <button type="submit" class="button">Search</button>
      {
        query && (
          <a
            href="/products"
            class="rounded-lg border border-zinc-300 px-6 py-3 text-base font-medium"
          >
            Clear
          </a>
        )
      }
    </form>
  </section>

  <section class="container pb-4 lg:flex lg:items-start lg:gap-10">
    <ProductFilters
      basePath="/products"
      q={query}
      limit={limit}
      order={order}
      filters={facetFilters}
      availability={deriveAvailabilityCounts(pool.products)}
      price={derivePriceBounds(pool.products)}
      options={deriveOptionFacets(pool.products)}
      collections={collections}
      resultLabel={pagination.label}
      stickyParams={stickyParams}
    />

    <div class="min-w-0 flex-1">
      {
        pageProducts.length > 0 ? (
          <Products
            products={pageProducts}
            eyebrow={query ? "Search" : "Catalog"}
            heading={query ? `Results for “${query}”` : "All products"}
            bare
          />
        ) : (
          <p class="py-16 text-center text-zinc-600">
            No products matched these filters.
          </p>
        )
      }
    </div>
  </section>

  <ProductPaginationNav
    pagination={pagination}
    pageHref={pageHref}
    previousOffset={Math.max(0, offset - limit)}
    nextOffset={offset + limit}
  />
</BaseLayout>
