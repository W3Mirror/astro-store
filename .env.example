PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_MEDUSA_REGION_ID=reg_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Any of the PUBLIC_MEDUSA_*, PUBLIC_STORE_NAME and PUBLIC_SITE_CONFIG_URL
# values left unset/empty fall back to .agents/w3dev/store.json (see DEPLOY.md).

# Disabled until the additive customer-engagement migration has been applied
# and MEDUSA_FF_CUSTOMER_ENGAGEMENT is enabled on the backend.
PUBLIC_CUSTOMER_ENGAGEMENT_ENABLED=false

# Disabled until the additive Medusa recommendation migration is applied and
# MEDUSA_FF_RECOMMENDATIONS is enabled on the backend.
PUBLIC_RECOMMENDATIONS_ENABLED=false

# Payment methods and delivery tracking are discovered from the Medusa
# backend's per-store payment and fulfillment plugin configuration.

# Optional. Set to "test" to build this storefront as the test twin: it
# renders a visible "Test store — orders aren't real" banner, forces
# noindex/nofollow on every page (meta tag + X-Robots-Tag header), and
# serves a robots.txt that disallows all crawling. Unset (or any other
# value) behaves exactly like today (the live store). Set by the per-store
# publish pipeline for test-site builds only — never for the live build.
PUBLIC_STORE_ENVIRONMENT=

# Optional, preferred name for the flag above: `live` or `test`. Wins over
# PUBLIC_STORE_ENVIRONMENT when non-empty; any other value fails the build.
STORE_ENVIRONMENT=

# Optional. Store name shown in the header, page titles, and footer.
# Defaults to "Your Store" when unset.
PUBLIC_STORE_NAME=

# Optional. Announcement banner message shown above the header. The banner
# is hidden entirely when this is unset/empty.
PUBLIC_ANNOUNCEMENT_MESSAGE=

# Optional. URL of the per-project public site-config endpoint
# (`GET /api/public/site-config/[projectId]?environment=test|live` on the
# store builder — the `?environment=` query selects which of the project's
# two site-config rows, TEST or LIVE, this build reads; set by the publish
# pipeline to match PUBLIC_STORE_ENVIRONMENT above). When set, its
# `storeName`/`announcementMessage`/`heroHeading`/`heroSubheading`/
# `logoUrl`/`faviconUrl`/`heroImageUrl`/`heroImageAlt`/`aboutImageUrl`
# fields overlay the env-based defaults above on every request (with a
# short in-memory cache). Unset or unreachable falls back to the env
# defaults exactly. The overlay also carries `whatsappNumber`,
# `sizeChartImageUrl`, `customFitNote`, `shippingText`, `returnsText`, and
# `showTestBanner` — see `utils/site-config.ts` and `utils/schemas.ts`.
PUBLIC_SITE_CONFIG_URL=
