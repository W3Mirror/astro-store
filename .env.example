PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_MEDUSA_REGION_ID=reg_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Disabled until the additive customer-engagement migration has been applied
# and MEDUSA_FF_CUSTOMER_ENGAGEMENT is enabled on the backend.
PUBLIC_CUSTOMER_ENGAGEMENT_ENABLED=false

# Disabled until the additive Medusa recommendation migration is applied and
# MEDUSA_FF_RECOMMENDATIONS is enabled on the backend.
PUBLIC_RECOMMENDATIONS_ENABLED=false

# Payment methods and delivery tracking are discovered from the Medusa
# backend's per-store payment and fulfillment plugin configuration.

# Optional. Store name shown in the header, page titles, and footer.
# Defaults to "Your Store" when unset.
PUBLIC_STORE_NAME=

# Optional. Announcement banner message shown above the header. The banner
# is hidden entirely when this is unset/empty.
PUBLIC_ANNOUNCEMENT_MESSAGE=

# Optional. URL of the per-project public site-config endpoint
# (`GET /api/public/site-config/[projectId]` on the store builder). When
# set, its `storeName`/`announcementMessage`/`heroHeading`/`heroSubheading`/
# `storefrontPreset` fields overlay the env-based defaults above on every
# request (with a short in-memory cache). `storefrontPreset` accepts minimal,
# editorial, or conversion. Unset or unreachable falls back to the env
# defaults exactly (including the minimal preset).
PUBLIC_SITE_CONFIG_URL=
